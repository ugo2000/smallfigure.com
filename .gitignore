# 本地单独存放：AI 生成的原图片，不随网站发布
originals/

# 部署暂存目录（wrangler pages deploy _site）
_site/

# AI 工作日志等本地数据，不进公开仓库
.workbuddy/

# 本地验证截图与临时预览图（_verify*.js / analyze_eng.py 等脚本保留）
tools/_*.png
processed/_*.png

# 仓库根目录的本地验收截图（_auth_modal_*.png / _final_*.png 等）
/_*.png

# OG 图母版：由 tools/make_og_image.py 本地生成，build-seo.mjs 按内容摘要复制为 og-<digest>.jpg
/og-1200x630.jpg

# 抠图中间产物与临时目录（定版成品 *_t.png 入库）
processed/_n4_tmp/
processed/_n4_tmp_raw/
processed/*_clean.png
processed/*_clean_mark.png

# 本轮抠图探索脚本（仅保留定版管线 _n4_pipeline3.py）
tools/_n4_*
!tools/_n4_pipeline3.py

# 一次性诊断脚本
tools/_diag_*

# 本地凭据文件（绝不进公开仓库）
.gh_token
.cf_token
.itch_token

# itch.io 调试过程截图（临时产物，不入库）
tools/itch_shots/
.env
.env.*
.dev.vars

# butler 二进制（itch.io 发布工具，体积大，仅本地使用，重新下载即可）
tools/butler/

# 依赖与系统文件
node_modules/
.DS_Store
Thumbs.db
*.log
.wrangler/
generated-images/

# character-art 抠图脚本本地副本（skill 目录已有，不入库）
tools/_cut/

# 构建产物：游戏发布包 / 截图（由 tools/build_game.py 生成，可重建）
outputs/
